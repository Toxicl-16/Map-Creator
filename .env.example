# Application settings
APP_NAME=Map-Creator Terrain Model Generator
APP_PORT=8000
APP_HOST=127.0.0.1

# Environment variables for external data sources (optional)
# These are optional; fallback providers will be used if not set

# OpenTopography API key (optional - provides additional elevation sources)
# Get free key at https://user.opentopography.org/
OPENTopo_API_KEY=

# Nominatim User-Agent (required for geocoding)
# Must identify your application: "AppName (<contact email>)"
NOMINATIM_USER_AGENT=Map-Creator Terrain Model Generator (research@none.com)

# Rate limit for external API calls per second
API_RATE_LIMIT_QPS=2.0
